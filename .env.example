# Copy to .env and fill in. All optional in development.
PORT=4000
# REQUIRED in production: a long random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# First owner account, created only if no staff accounts exist yet.
# Remove ADMIN_PASSWORD from this file after the first start.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
# Number of reverse proxies in front of the panel (nginx = 1, Cloudflare + nginx = 2).
# Leave at 0 if the panel is exposed directly, or anyone can fake their IP.
TRUST_PROXY=0
# Where staff accounts and the audit log are stored. Default: server/data
DATA_DIR=
# "mock" (default) or "live" once the dev implements src/game/liveAdapter.js
GAME_ADAPTER=mock
# Used by liveAdapter.js
GAME_API_URL=
GAME_API_KEY=
