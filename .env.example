# Copy to .env and fill in. All optional in dev.
PORT=4000
# Long random string. If unset, a random one is generated each start (everyone gets logged out on restart).
JWT_SECRET=
# First owner account, created only if no admin accounts exist yet.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
# "mock" (default) or "live" once the dev implements src/game/liveAdapter.js
GAME_ADAPTER=mock
# Used by liveAdapter.js
GAME_API_URL=
GAME_API_KEY=
